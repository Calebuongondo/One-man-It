{
  "brand_name": "NovaTrade",
  "brand_domain": "oneman-trade.onrender.com",
  "brand_hostname": {
    "staging": "staging.oneman-trade.onrender.com/dashboard",
    "production": "oneman-trade.onrender.com/dashboard"
  },
  "domain_name": "NovaTrade",
  "colors": {
    "primary": "#00a88f",
    "secondary": "#344054",
    "tertiary": "#7c5cff",
    "success": "#12b76a",
    "danger": "#f04438",
    "warning": "#f79009",
    "info": "#2e90fa",
    "neutral": "#667085",
    "black": "#101828",
    "white": "#ffffff",
    "grey": {
      "50": "#f9fafb",
      "100": "#f2f4f7",
      "200": "#eaecf0",
      "300": "#d0d5dd",
      "400": "#98a2b3",
      "500": "#667085",
      "600": "#475467",
      "700": "#344054",
      "800": "#1d2939",
      "900": "#101828"
    }
  },
  "typography": {
    "font_family": {
      "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "secondary": "Georgia, 'Times New Roman', Times, serif",
      "monospace": "'Courier New', Courier, monospace"
    },
    "font_sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    }
  },
  "color_variants": {
    "light_variants": [
      100,
      200,
      300,
      400,
      500
    ],
    "dark_variants": [
      600,
      700,
      800,
      900
    ],
    "opacity_variants": [
      10,
      20,
      30,
      40,
      50,
      60,
      70,
      80,
      90
    ]
  },
  "theme_config": {
    "enable_dynamic_themes": true,
    "auto_generate_variants": true,
    "css_variable_prefix": "--brand"
  },
  "platform": {
    "name": "NovaTrade",
    "logo": {
      "type": "component",
      "component_name": "BrandLogo",
      "alt_text": "NovaTrade",
      "link_url": "/",
      "show_text": true,
      "text": "NovaTrade"
    },
    "footer": {
      "enable_language_settings": false,
      "enable_theme_toggle": true
    },
    "hostname": {
      "production": {
        "com": "oneman-trade.onrender.com"
      },
      "staging": {
        "com": "staging-oneman-trade.onrender.com"
      }
    },
    "auth2_url": {
      "production": "https://auth.deriv.com/oauth2/",
      "staging": "https://staging-auth.deriv.com/oauth2/"
    },
    "derivws": {
      "url": {
        "staging": "https://staging-api.derivws.com/trading/v1/",
        "production": "https://api.derivws.com/trading/v1/"
      },
      "directories": {
        "options": "options/",
        "derivatives": "derivatives/"
      }
    }
  }
}